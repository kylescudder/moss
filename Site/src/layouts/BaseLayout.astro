---
import '../styles/global.css'
import DocumentHead from '../components/DocumentHead.astro'
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'

interface Props {
  title: string
  description: string
  ogTitle?: string
}

const { title, description, ogTitle = title } = Astro.props
---

<!doctype html>
<html lang='en'>
  <head>
    <DocumentHead title={title} description={description} ogTitle={ogTitle} />
  </head>
  <body>
    <a class='skip-link' href='#main'>Skip to content</a>
    <Header />
    <main id='main'>
      <slot />
    </main>
    <Footer />
  </body>
</html>
