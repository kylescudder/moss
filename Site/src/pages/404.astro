---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title='Page not found - Moss'
  description='This page does not exist on the Moss website.'
  bodyClass='not-found-page'
>
  <main>
  <section class='lost' aria-labelledby='lost-title'>
    <div class='lost-line' aria-hidden='true'></div>
    <h1 id='lost-title'>Page not found</h1>
    <p>
      There's nothing at this address. The link may be mistyped, or the page may
      have moved.
    </p>
    <div class='actions'>
      <a class='button' href='/'>Go to the home page</a>
      <a class='text-link' href='/support'>Get support</a>
    </div>
  </section>
  </main>
</BaseLayout>
