---
import BaseLayout from '../layouts/BaseLayout.astro'
import { appStoreUrl } from '../lib/links'

const stops = [
  { time: '07:40', kind: 'Flight', title: 'Gatwick to Lisbon' },
  { time: '11:30', kind: 'Lodging', title: 'Check in at the flat in Alfama' },
  { time: '13:00', kind: 'Food', title: 'Lunch at Cervejaria Ramiro' },
  { time: '16:00', kind: 'Transport', title: 'Tram 28 up to Graça', next: true },
  {
    time: '19:30',
    kind: 'Activity',
    title: 'Sunset at Senhora do Monte'
  },
  { time: '', kind: 'Note', title: 'Book Belém tower tickets for Saturday' }
]

const today = [
  { time: '09:00', title: 'Pastéis de Belém' },
  { time: '10:30', title: 'Jerónimos Monastery' },
  { time: '14:15', title: 'Train to Cascais' }
]

const planned = [
  'Trips shared with the people you travel with',
  'Maps of every place on a trip',
  'Photos and journals',
  'Packing lists and expenses'
]
---

<BaseLayout
  title='Moss — Travel, together'
  description='Moss keeps your flights, stays, meals and plans together on your iPhone, sorted by day. Free on the App Store.'
  ogTitle='Moss — Travel, together'
>
  <div class='wrap'>
    <section class='hero' aria-labelledby='hero-title'>
      <div class='hero-copy'>
        <h1 id='hero-title'>Your trip, in the order it happens.</h1>
        <p class='lede'>
          Moss keeps flights, stays, meals and plans together on your iPhone,
          sorted by day. Open it and see what comes next.
        </p>
        <div class='actions'>
          <a class='button' href={appStoreUrl}>Download on the App Store</a>
          <a class='text-link' href='#how'>How it works</a>
        </div>
        <p class='fine'>
          Free to download for iPhone and iPad.
        </p>
      </div>

      <figure class='route' aria-labelledby='route-caption'>
        <p class='route-trip'>
          <strong>Lisbon</strong>
          <span>14 to 17 May</span>
        </p>
        <p class='route-day'>Friday 14 May</p>
        <ol class='stops'>
          {
            stops.map((stop) => (
              <li class:list={['stop', { 'is-next': stop.next }]}>
                {stop.time ? (
                  <time>{stop.time}</time>
                ) : (
                  <span class='time-empty' />
                )}
                <span class='stop-text'>
                  <span class='stop-title'>{stop.title}</span>
                  <span class='stop-kind'>
                    {stop.kind}
                    {stop.next && <span class='next-tag'>Next</span>}
                  </span>
                </span>
              </li>
            ))
          }
        </ol>
        <figcaption id='route-caption'>
          An example day in Moss, using made-up plans.
        </figcaption>
      </figure>
    </section>

    <div class='bend' aria-hidden='true'></div>

    <section class='journey' id='how' aria-label='How Moss works'>
      <div class='station'>
        <h2>Before you go</h2>
        <div class='station-body'>
          <p>
            Start a trip with a destination and dates. As you book things, add
            them: flights, stays, meals, activities, transport and notes. Moss
            sorts them by day and time, so the plan reads top to bottom.
          </p>
          <dl class='ticket'>
            <div><dt>Trip</dt><dd>Lisbon</dd></div>
            <div><dt>Dates</dt><dd>14 to 17 May</dd></div>
            <div><dt>Notes</dt><dd>Bring the good walking shoes.</dd></div>
          </dl>
        </div>
      </div>

      <div class='station'>
        <h2>On the day</h2>
        <div class='station-body'>
          <p>
            Today shows everything happening today, across all your trips, in
            time order. Turn on reminders and Moss will nudge you before things
            start.
          </p>
          <div class='today'>
            <p class='today-title'>Today</p>
            <ol>
              {
                today.map((item) => (
                  <li>
                    <time>{item.time}</time>
                    {item.title}
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </div>

      <div class='station'>
        <h2>Back home</h2>
        <div class='station-body'>
          <p>
            Your trips sync across your devices and stay put when you're home.
            When someone asks where you had that lunch, it's still there.
          </p>
        </div>
      </div>

      <div class='station is-terminus' id='download'>
        <h2>Get Moss</h2>
        <div class='station-body'>
          <p>
            Moss is on the App Store for iPhone and iPad. Your first two trips
            are free. Supporter Monthly unlocks unlimited trips and helps fund
            what comes next.
          </p>
          <div class='actions'>
            <a class='button' href={appStoreUrl}>Download on the App Store</a>
            <a class='text-link' href='/support'>Get support</a>
          </div>
        </div>
      </div>

      <div class='station is-planned'>
        <h2>Further down the line</h2>
        <div class='station-body'>
          <p>
            Planned, not built yet. These are next once the itinerary is solid:
          </p>
          <ul class='planned'>
            {planned.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>

    </section>
  </div>
</BaseLayout>
