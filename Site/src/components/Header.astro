---
const path = Astro.url.pathname
const links = [
  { href: path === '/' ? '#how' : '/#how', label: 'How it works' },
  { href: '/support', label: 'Support' }
]
---

<a class='skip-link' href='#content'>Skip to content</a>
<header class='site-header'>
  <a class='brand' href='/' aria-label='Moss home'>
    <img src='/assets/moss-mark.svg' alt='' width='36' height='36' />
    <span>Moss</span>
  </a>
  <nav aria-label='Site'>
    {
      links.map((link) => (
        <a
          href={link.href}
          aria-current={link.href === path ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
<!-- The shared layout puts each page's <main> right after the header. -->
<span id='content' tabindex='-1'></span>
