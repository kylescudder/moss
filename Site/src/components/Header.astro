---
const path = Astro.url.pathname;
const current = path === "/" ? "home" : path.split("/").filter(Boolean)[0];

const navLinks =
  current === "home"
    ? [
        { href: "#journeys", label: "Journeys" },
        { href: "#memory", label: "Memory" },
        { href: "/support", label: "Support" },
      ]
    : current === "support"
      ? [
          { href: "/", label: "Home" },
          { href: "/privacy", label: "Privacy" },
          { href: "/terms", label: "Terms" },
        ]
      : current === "privacy"
        ? [
            { href: "/support", label: "Support" },
            { href: "/terms", label: "Terms" },
          ]
        : [
            { href: "/support", label: "Support" },
            { href: "/privacy", label: "Privacy" },
          ];
---

<header class="site-header">
  <a class="brand-link" href="/" aria-label="Moss home">
    <span class="logo" aria-hidden="true">
      <img src="/assets/moss-mark.svg" alt="" width="38" height="38" />
    </span>
    <span class="wordmark">Moss</span>
  </a>
  <nav class="site-nav" aria-label="Site links">
    {
      navLinks.map((link) => (
        <a class="nav-word" href={link.href}>
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
