---
interface Props {
  title: string
  updated?: string
}

const { title, updated } = Astro.props
---

<article class='document'>
  <header class='document-head'>
    <h1>{title}</h1>
    {updated && <p class='updated'>Last updated {updated}</p>}
  </header>
  <div class='document-body'>
    <slot />
  </div>
  <p class='document-end'>
    Something not covered here? Email{' '}
    <a href='mailto:support@getmoss.app'>support@getmoss.app</a>.
  </p>
</article>
