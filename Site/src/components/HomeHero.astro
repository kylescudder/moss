---
import app from "../../app.json";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="kicker">Travel, together</p>
    <h1 id="hero-title">Moss</h1>
    <p class="lede">
      Plan what is ahead, hold onto what matters, and keep every trip connected
      in one thoughtful place.
    </p>
    <div class="button-row">
      <a
        class="button button-moss"
        href={`mailto:${app.contact}?subject=Moss%20TestFlight`}
      >
        Request TestFlight access
      </a>
      <a class="button button-line" href="#journeys">Explore Moss</a>
    </div>
  </div>
  <div class="journey-panel" aria-hidden="true">
    <div class="memory-card card-primary">
      <span>Kyoto</span>
      <strong>Spring days, temple walks, quiet dinners.</strong>
    </div>
    <div class="memory-card card-secondary">
      <span>Next</span>
      <strong>Notes, places, stays, and plans in one place.</strong>
    </div>
  </div>
</section>
